#: data/org.ayatana.indicator.display.gschema.xml:1
msgid "Lock rotation"
msgstr "Bloqueja la rotació"

#: data/org.ayatana.indicator.display.gschema.xml:2
msgid "Lock automatic display rotation."
msgstr "Bloqueja la rotació automàtica de la pantalla."

#: data/org.ayatana.indicator.display.gschema.xml:3
msgid "Orientation lock"
msgstr "Blocatge de l'orientació"

#: data/org.ayatana.indicator.display.gschema.xml:4
msgid "Locks orientation to a specific value."
msgstr "Bloqueja l'orientació a un valor especificat."

#: data/org.ayatana.indicator.display.gschema.xml:5 src/service.cpp:611
msgid "Color temperature"
msgstr "Temperatura del color"

#: data/org.ayatana.indicator.display.gschema.xml:6
msgid ""
"Sets the color temperature of your screen. The lower the value, the higher "
"the intensity of the redness effect applied to the display."
msgstr ""
"Estableix la temperatura de color de la pantalla. Com més baix sigui el "
"valor, més alta serà la intensitat de l'efecte vermellós aplicat a la "
"pantalla."

#: data/org.ayatana.indicator.display.gschema.xml:7 src/service.cpp:622
msgid "Color temperature profile"
msgstr "Perfil de temperatura de color"

#: data/org.ayatana.indicator.display.gschema.xml:8
msgid "The current color temperature profile being used by the indicator."
msgstr "El perfil de temperatura de color actual que utilitza l'indicador."

#: data/org.ayatana.indicator.display.gschema.xml:9
msgid "Screen brightness"
msgstr "Brillantor de la pantalla"

#: data/org.ayatana.indicator.display.gschema.xml:10
msgid "Stores the current brightness value of your screen."
msgstr "Emmagatzema el valor de brillantor actual de la pantalla."

#: data/org.ayatana.indicator.display.gschema.xml:11
msgid "The name of the light theme"
msgstr "El nom del tema clar"

#: data/org.ayatana.indicator.display.gschema.xml:12
msgid "This is the theme the indicator will set when \"Light\" is selected."
msgstr "Aquest és el tema que l'indicador establirà quan se seleccioni «Clar»."

#: data/org.ayatana.indicator.display.gschema.xml:13
msgid "The name of the dark theme"
msgstr "El nom del tema fosc"

#: data/org.ayatana.indicator.display.gschema.xml:14
msgid "This is the theme the indicator will set when \"Dark\" is selected."
msgstr "Aquest és el tema que l'indicador establirà quan se seleccioni «Fosc»."

#: data/org.ayatana.indicator.display.gschema.xml:15
#: src/service.cpp:650
msgid "Theme profile"
msgstr "Perfil del tema"

#: data/org.ayatana.indicator.display.gschema.xml:16
msgid "The current theme profile being used by the indicator."
msgstr "El perfil del tema actual que està usant l'indicador."

#: data/org.ayatana.indicator.display.gschema.xml:17
msgid "Current geographic latitude"
msgstr "Latitud geogràfica actual"

#: data/org.ayatana.indicator.display.gschema.xml:18
msgid "Stores the last recorded geographic latitude of the device."
msgstr "Emmagatzema l'última latitud geogràfica registrada del dispositiu."

#: data/org.ayatana.indicator.display.gschema.xml:19
msgid "Current geographic longitude"
msgstr "Longitud geogràfica actual"

#: data/org.ayatana.indicator.display.gschema.xml:20
msgid "Stores the last recorded geographic longitude of the device."
msgstr "Emmagatzema l'última longitud geogràfica registrada del dispositiu."

